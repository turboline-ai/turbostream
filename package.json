{
  "name": "turbostream",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"GO ,WEB\" \"go run ./cmd/server\" \"npm run dev --prefix web\"",
    "dev:go": "go run ./cmd/server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "test": "npm test --prefix web",
    "install:web": "npm install --prefix web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
